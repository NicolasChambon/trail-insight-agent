# Local, non-versioned working files (brief, scratch, private notes)
local/

# Python
__pycache__/
*.py[cod]
.venv/

# ADK local state - session history, rewritten on every run
.adk/

# Environment & secrets - Never commit
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/

# Personal data - never commit
data/

# OAuth client secret and user tokens - never commit. The token file is the 
# athlete's delegation: whoever holds it reads the calendar and sends mail as 
# him, with no password and no second factor.
credentials/