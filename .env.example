# Anthropic API key - get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Strava API credentials - create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Google AI Studio - the agent's model. The key must belong to the
# trail-insight-agent project, which carries the billing account: the free tier
# stops at 20 requests per day per project per model, and one question that 
# chains two tools spends three of them.
# Get a key at https://aistudio.google.com/apikey
#
# FALSE = AI Studio, TRUE = Vertex AI. Renamed from
# GOOGLE_GENAI_USE_VERTEXAI, which google-genai still reads as a legacy
# alias; the new name wins when both are set.
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=